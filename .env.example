# Shop&Go Kortrijk — Vercel + Supabase

# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Public Google Maps JavaScript browser key (optional).
# OSM/Leaflet is the default map. Set VITE_USE_GOOGLE_MAPS=true only with a
# production-restricted browser key to enable Google Maps instead of OpenStreetMap.
VITE_GOOGLE_MAPS_PLATFORM_KEY=
VITE_MAP_PROVIDER=auto
VITE_USE_GOOGLE_MAPS=false

# Public Stripe publishable key used only by the web/PWA build.
# Native Android store builds disable Stripe checkout and use store billing instead.
VITE_PAYMENTS_CLIENT_TOKEN=

# Server-only configuration — set in Vercel Environment Variables, never with VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Canonical trusted web origin used to validate Stripe return URLs.
# Example: https://shopgo-kortrijk.vercel.app
APP_ORIGIN=

# GET /api/spots IP rate limit (fail-closed when misconfigured)
SPOTS_RATE_LIMIT_MAX=60
SPOTS_RATE_LIMIT_WINDOW_SEC=60
