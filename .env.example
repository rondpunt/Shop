# Shop&Go Kortrijk — Vercel + Supabase + Netlify

# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Public Google Maps JavaScript browser key (optional — OSM fallback works without it).
# Restrict to Maps JavaScript API + your web origins.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Public Stripe publishable key — web/PWA only (pk_test_… for development).
# Native Android store builds use Play Billing instead of Stripe.
VITE_PAYMENTS_CLIENT_TOKEN=

# ── Server-only (Netlify/Vercel env, NEVER VITE_ prefix) ──
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_…  # TODO: wire webhook handler for subscription sync
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Canonical trusted web origin for Stripe return URL validation.
# Example: https://shopgo-kortrijk-denkstof.netlify.app
APP_ORIGIN=

# Stripe Price lookup keys (create in Dashboard):
#   premium_monthly → €3,99/month
#   premium_yearly  → €29,99/year
# Display amounts: src/lib/pricing.ts
