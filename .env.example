# Shop&Go Kortrijk — Vercel + Supabase

# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only Supabase key — set in Vercel, NEVER expose with VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# Browser publishable key/token used by Stripe.js
VITE_PAYMENTS_CLIENT_TOKEN=
# Server secret used only by Vercel /api functions
STRIPE_SECRET_KEY=

# Gemini — server only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Maps browser key. Restrict this key to the production/preview domains
# and only the required Google Maps APIs in Google Cloud Console.
GOOGLE_MAPS_PLATFORM_KEY=
