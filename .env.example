# Shop&Go Kortrijk — Vercel + Supabase
#
# Migrating from Replit? See docs/REPLIT_ENV_MIGRATION.md — Clerk/SESSION_SECRET are not used;
# a Stripe pk_live_ key stored as SUPABASE_SERVICE_ROLE_KEY in Replit belongs in
# VITE_PAYMENTS_CLIENT_TOKEN instead.

# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Public Google Maps JavaScript browser key.
# This key is visible to clients by design. Restrict it to the required Maps APIs,
# approved web origins where possible, quotas and billing alerts.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Public Stripe publishable key used only by the web/PWA build.
# Native Android store builds disable Stripe checkout and use store billing instead.
VITE_PAYMENTS_CLIENT_TOKEN=

# Server-only configuration — set in Vercel Environment Variables, never with VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Canonical trusted web origin used to validate Stripe return URLs.
# Example: https://shopgo-kortrijk.vercel.app
APP_ORIGIN=
